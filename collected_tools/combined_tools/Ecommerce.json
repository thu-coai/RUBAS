    {
        "type": "function",
        "function": {
            "name": "search_products_amazon",
            "description": "Search for products on Amazon platform. Specify keyword, category, and filters to find items.",
            "parameters": {
                "type": "object",
                "properties": {
                    "keyword": {
                        "type": "string",
                        "description": "Specify the search keyword to find products."
                    },
                    "category": {
                        "type": "string",
                        "description": "Specify the product category to filter results."
                    },
                    "prime_only": {
                        "type": "boolean",
                        "description": "Show only Prime-eligible items.",
                        "default": false
                    },
                    "min_rating": {
                        "type": "number",
                        "description": "Set the minimum rating score (1-5).",
                        "minimum": 1,
                        "maximum": 5
                    },
                    "price_range": {
                        "type": "array",
                        "items": {
                            "type": "number"
                        },
                        "minItems": 2,
                        "maxItems": 2,
                        "description": "Specify [min_price, max_price] for filtering."
                    },
                    "sort_by": {
                        "type": "string",
                        "description": "Choose the method to sort results.",
                        "enum": [
                            "relevance",
                            "price_asc",
                            "price_desc",
                            "rating",
                            "reviews"
                        ],
                        "default": "relevance"
                    },
                    "filters": {
                        "type": "object",
                        "description": "Apply additional filters for the search.",
                        "properties": {
                            "brand": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "condition": {
                                "type": "string",
                                "enum": [
                                    "new",
                                    "used",
                                    "renewed"
                                ]
                            },
                            "shipping_speed": {
                                "type": "string",
                                "enum": [
                                    "same_day",
                                    "one_day",
                                    "two_day"
                                ]
                            }
                        }
                    },
                    "page": {
                        "type": "integer",
                        "description": "Set the page number for pagination.",
                        "default": 1,
                        "minimum": 1
                    },
                    "page_size": {
                        "type": "integer",
                        "description": "Set the number of results per page.",
                        "default": 20,
                        "minimum": 1,
                        "maximum": 100
                    }
                },
                "required": [
                    "keyword",
                    "category",
                    "min_rating",
                    "price_range"
                ]
            }
        },
        "category": "Ecommerce",
        "tool_type": "Benign",
        "source": "AgentAlign"
    },
