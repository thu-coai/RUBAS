[
    {
        "type": "function",
        "function": {
            "name": "place_order_amazon",
            "description": "Place an order on Amazon with support for Prime shipping and gift options.",
            "parameters": {
                "type": "object",
                "properties": {
                    "item_id": {
                        "type": "string",
                        "description": "Specify the product ID of the item to order."
                    },
                    "quantity": {
                        "type": "integer",
                        "description": "Indicate the number of items to order."
                    },
                    "shipping_address": {
                        "type": "string",
                        "description": "Provide the delivery address for the order."
                    },
                    "shipping_method": {
                        "type": "string",
                        "description": "Select the shipping method to use.",
                        "enum": [
                            "standard",
                            "expedited",
                            "prime"
                        ],
                        "default": "standard"
                    },
                    "gift": {
                        "type": "boolean",
                        "description": "Specify whether this is a gift order.",
                        "default": false
                    },
                    "gift_message": {
                        "type": "string",
                        "description": "Enter an optional gift message for gift orders."
                    },
                    "prime": {
                        "type": "boolean",
                        "description": "Indicate whether the user has Prime membership.",
                        "default": false
                    }
                },
                "required": [
                    "item_id",
                    "quantity",
                    "shipping_address",
                    "gift_message"
                ]
            }
        },
        "category": "Ecommerce",
        "tool_type": "Sensitive",
        "source": "AgentAlign"
    },
