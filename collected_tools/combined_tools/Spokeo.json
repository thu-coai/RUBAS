        "function": {
            "name": "search_people",
            "description": "Search for people by name, email, phone number, or address.",
            "parameters": {
                "type": "object",
                "properties": {
                    "search_term": {
                        "type": "string",
                        "description": "Provide the search term for the person."
                    },
                    "search_type": {
                        "type": "string",
                        "description": "Specify the type of search.",
                        "enum": [
                            "name",
                            "email",
                            "phone",
                            "address"
                        ]
                    },
                    "max_results": {
                        "type": "integer",
                        "description": "Set the maximum number of results to return.",
                        "minimum": 1,
                        "default": 10
                    }
                },
                "required": [
                    "search_term",
                    "search_type"
                ]
            }
        },
