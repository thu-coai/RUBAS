        "function": {
            "name": "manage_appointments",
            "description": "View, update, or cancel appointments by providing the appointment's unique identifier and any updates or cancellation requests.",
            "parameters": {
                "type": "object",
                "properties": {
                    "appointment_id": {
                        "type": "string",
                        "description": "The unique identifier of the appointment."
                    },
                    "action": {
                        "type": "string",
                        "description": "The action to perform on the appointment ('view', 'update', 'cancel').",
                        "enum": [
                            "view",
                            "update",
                            "cancel"
                        ]
                    },
                    "date": {
                        "type": "string",
                        "description": "Updated date of the appointment in the format 'YYYY-MM-DD' if action is 'update'."
                    },
                    "time": {
                        "type": "string",
                        "description": "Updated time of the appointment in the format 'HH:mm' if action is 'update'."
                    }
                },
                "required": [
                    "appointment_id",
                    "action"
                ]
            }
        },
