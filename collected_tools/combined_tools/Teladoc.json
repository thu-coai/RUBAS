            "name": "search_doctors",
            "description": "Search for doctors based on keywords, specialty, location, and a specific date.",
            "parameters": {
                "type": "object",
                "properties": {
                    "keywords": {
                        "type": "string",
                        "description": "Keywords to search doctors by, such as name or specialty."
                    },
                    "location": {
                        "type": "string",
                        "description": "Location to filter doctors by."
                    },
                    "date": {
                        "type": "string",
                        "description": "Date to check doctor's availability in the format 'YYYY-MM-DD'."
                    }
                },
                "required": [
                    "keywords",
                    "location",
                    "date"
                ]
            }
        },
