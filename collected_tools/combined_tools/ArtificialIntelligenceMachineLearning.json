                    },
                    "height": {
                        "type": "integer",
                        "description": "Output image height",
                        "default": 1024
                    },
                    "sampler": {
                        "type": "string",
                        "description": "Sampling algorithm for generation",
                        "default": "DPM++ 2M Karras"
                    }
                },
                "required": [
                    "prompt",
                    "negative_prompt",
                    "seed"
                ]
