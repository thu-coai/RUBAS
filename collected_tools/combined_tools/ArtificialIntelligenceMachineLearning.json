                        ],
                        "default": "V6"
                    },
                    "aspect_ratio": {
                        "type": "string",
                        "description": "Specify the output image aspect ratio.",
                        "default": "1:1"
                    },
                    "quality": {
                        "type": "number",
                        "description": "Set the quality level affecting generation time and detail (0.25-2.0).",
                        "minimum": 0.25,
                        "maximum": 2.0,
                        "default": 1.0
                    },
                    "style_params": {
                        "type": "object",
                        "description": "Provide optional parameters for fine-tuning the style."
                    }
                },
                "required": [
                    "prompt"
                ]
            }
        },
