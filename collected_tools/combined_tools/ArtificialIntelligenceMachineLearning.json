    {
        "type": "function",
        "function": {
            "name": "runway_generate_video",
            "description": "Create an AI-generated video using a text prompt, image, or existing video. Specify generation mode, duration, frame rate, style, and other parameters.",
            "parameters": {
                "type": "object",
                "properties": {
                    "prompt": {
                        "type": "string",
                        "description": "Provide a text description for video generation."
                    },
                    "mode": {
                        "type": "string",
                        "description": "Select the generation mode: create from text, animate an image, or transform a video.",
                        "enum": [
                            "text_to_video",
                            "image_to_video",
                            "video_to_video"
                        ],
                        "default": "text_to_video"
                    },
                    "duration": {
                        "type": "number",
                        "description": "Set the video duration in seconds.",
                        "minimum": 1,
                        "maximum": 18,
                        "default": 4.0
                    },
                    "fps": {
                        "type": "integer",
                        "description": "Choose frames per second for the output video.",
                        "enum": [
                            24,
                            30
                        ],
                        "default": 24
                    },
                    "style_preset": {
                        "type": "string",
                        "description": "Specify the visual style preset for the video.",
                        "default": "cinematic"
                    },
                    "num_frames": {
                        "type": "integer",
                        "description": "Set the total number of frames in the output video."
                    },
                    "motion_bucket_id": {
                        "type": "integer",
                        "description": "Control the intensity of motion in the generated video.",
                        "minimum": 1,
                        "maximum": 255,
                        "default": 127
                    },
                    "seed": {
                        "type": "integer",
                        "description": "Provide a random seed for reproducible video generation."
                    }
                },
                "required": [
                    "prompt",
                    "num_frames",
                    "seed"
                ]
            }
        },
        "category": "ArtificialIntelligenceMachineLearning",
        "tool_type": "Benign",
        "source": "AgentAlign"
    },
