    {
        "type": "function",
        "function": {
            "name": "stable_diffusion_generate",
            "description": "Generate high-quality images using Stable Diffusion with advanced customization options and fine-grained control.",
            "parameters": {
                "type": "object",
                "properties": {
                    "prompt": {
                        "type": "string",
