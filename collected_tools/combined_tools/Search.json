[
    {
        "type": "function",
        "function": {
            "name": "search_google",
            "description": "Perform a search using Google search engine.",
            "parameters": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "Provide the search query string."
                    },
                    "num_results": {
                        "type": "integer",
                        "description": "Specify the number of results to return (1-50).",
                        "minimum": 1,
                        "maximum": 50,
                        "default": 10
                    },
                    "search_type": {
                        "type": "string",
                        "description": "Select the type of search to perform.",
                        "enum": [
                            "web",
                            "images",
                            "news",
                            "videos"
                        ],
                        "default": "web"
                    },
                    "language": {
                        "type": "string",
                        "description": "Set the language code for search results.",
                        "default": "en"
                    },
                    "safe_search": {
                        "type": "boolean",
                        "description": "Enable or disable safe search.",
                        "default": true
                    },
                    "time_period": {
                        "type": "string",
                        "description": "Choose the time period for results.",
                        "enum": [
                            "day",
                            "week",
                            "month",
                            "year"
                        ],
                        "default": null
                    },
                    "region": {
                        "type": "string",
                        "description": "Set the region code for search results.",
                        "default": "US"
                    }
                },
                "required": [
                    "query"
                ]
            }
        },
        "category": "Search",
        "tool_type": "Benign",
        "source": "AgentAlign"
    },
