    {
        "type": "function",
        "function": {
            "name": "search_merchant_meituan",
            "description": "Search for merchants or stores on the Meituan platform, including restaurants, grocery stores, and pharmacies.",
            "parameters": {
                "type": "object",
                "properties": {
                    "keyword": {
                        "type": "string",
                        "description": "Provide a search keyword to find merchants."
                    },
                    "location": {
                        "type": "string",
                        "description": "Specify the user's current location or delivery address."
                    },
                    "sort_by": {
                        "type": "string",
                        "description": "Select a method to sort results.",
                        "enum": [
                            "comprehensive",
                            "distance",
                            "rating",
                            "sales"
                        ],
                        "default": "comprehensive"
                    },
                    "filters": {
                        "type": "object",
                        "description": "Apply additional filters for the search.",
                        "properties": {
                            "price_range": {
                                "type": "array",
                                "items": {
                                    "type": "number"
                                },
                                "description": "Set minimum and maximum price range."
                            },
                            "cuisine_type": {
                                "type": "string",
                                "description": "Specify the type of cuisine or store category."
                            },
                            "delivery_time": {
                                "type": "integer",
                                "description": "Set the maximum delivery time in minutes."
                            }
                        },
                        "required": [
                            "price_range",
                            "cuisine_type",
                            "delivery_time"
                        ]
                    },
                    "page": {
                        "type": "integer",
                        "description": "Set the page number for pagination.",
                        "default": 1,
                        "minimum": 1
                    },
                    "page_size": {
                        "type": "integer",
                        "description": "Set the number of results per page.",
                        "default": 20,
                        "minimum": 1,
                        "maximum": 100
                    }
                },
                "required": [
                    "keyword",
                    "location"
                ]
            }
        },
        "category": "LocalServices",
        "tool_type": "Benign",
        "source": "AgentAlign"
    },
