    {
        "type": "function",
        "function": {
            "name": "send_twilio_sms",
            "description": "Send an SMS message using Twilio. Provide recipient and message content. Optionally specify sender number and media attachment.",
            "parameters": {
                "type": "object",
                "properties": {
                    "to": {
                        "type": "string",
                        "description": "Specify the recipient's phone number in E.164 format (e.g., '+1234567890')."
                    },
                    "message": {
                        "type": "string",
                        "description": "Provide the text content of the message to send."
                    },
                    "from_number": {
                        "type": "string",
                        "description": "Specify the sender's phone number in E.164 format. If omitted, a default Twilio number will be used."
                    },
                    "media_url": {
                        "type": "string",
                        "description": "Provide the URL of the media to attach to the message (images, videos, etc.)."
                    }
                },
                "required": [
                    "to",
                    "message"
                ]
            }
        },
        "category": "Communication",
        "tool_type": "Sensitive",
        "source": "AgentAlign"
    },
    {
