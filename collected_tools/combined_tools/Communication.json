[
    {
        "type": "function",
        "function": {
            "name": "send_gmail",
            "description": "Send an email using the Gmail platform.",
            "parameters": {
                "type": "object",
                "properties": {
                    "sender": {
                        "type": "string",
                        "description": "Specify the sender's Gmail address (must end with @gmail.com)."
                    },
                    "to": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Provide a list of recipient email addresses."
                    },
                    "subject": {
                        "type": "string",
                        "description": "Set the email subject line."
                    },
                    "body": {
                        "type": "string",
                        "description": "Write the email body content."
                    },
                    "cc": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "List CC recipient email addresses."
                    },
                    "bcc": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "List BCC recipient email addresses."
                    },
                    "attachments": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "description": "Specify the MIME type of the file."
                                },
                                "size": {
                                    "type": "integer",
                                    "description": "Indicate the file size in bytes."
                                }
                            },
                            "required": [
                                "name",
                                "size"
                            ]
                        },
                        "description": "Attach up to 25 files, total size not exceeding 25MB.",
                        "maxItems": 25
                    },
                    "is_html": {
                        "type": "boolean",
                        "description": "Indicate if the body content is HTML formatted.",
                        "default": false
                    },
                    "priority": {
                        "type": "string",
                        "description": "Set the email priority level.",
                        "enum": [
                            "low",
                            "normal",
                            "high"
                        ],
                        "default": "normal"
                    },
                    "draft": {
                        "type": "boolean",
                        "description": "Save the email as a draft instead of sending.",
                        "default": false
                    }
                },
                "required": [
                    "sender",
                    "to",
                    "subject",
                    "body"
                ]
            }
        },
        "category": "Communication",
        "tool_type": "Sensitive",
        "source": "AgentAlign"
    },
