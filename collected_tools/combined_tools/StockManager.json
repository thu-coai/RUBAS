    {
        "type": "function",
        "function": {
            "name": "trade_stock",
            "description": "Place an order to buy or sell a stock in a user account.",
            "parameters": {
                "type": "object",
                "properties": {
                    "account": {
                        "type": "string",
                        "description": "Specify the account number. Must be a 'self-directed TFSA' or 'self-directed non-registered' account."
                    },
                    "action": {
                        "type": "string",
                        "description": "Specify whether to buy or sell the stock.",
                        "enum": [
                            "buy",
                            "sell"
                        ]
                    },
                    "order_type": {
                        "type": "string",
                        "description": "Specify the order type.",
                        "enum": [
                            "limit_order",
                            "market_order"
                        ]
                    },
                    "ticker": {
                        "type": "string",
                        "description": "Specify the ticker symbol of the stock."
                    },
                    "quantity": {
                        "type": "number",
                        "description": "Specify the number of shares to buy or sell."
                    },
                    "price_limit": {
                        "type": "number",
                        "description": "Specify the price limit for limit orders. Required if order_type is 'limit_order'."
                    }
                },
                "required": [
                    "account",
                    "action",
                    "order_type",
                    "ticker",
                    "quantity"
                ]
            }
        },
