        "type": "function",
        "function": {
            "name": "modify_user_access",
            "description": "Modify the access rights of a given user, either granting or removing access to specific resources.",
            "parameters": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string",
                        "description": "Specify the username of the employee whose access rights are to be modified."
                    },
                    "access_changes": {
                        "type": "object",
                        "properties": {
                            "grant": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "description": "Resource to be granted access to."
                                },
                                "description": "List of resources to grant access to."
                            },
                            "revoke": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "description": "Resource to revoke access from."
                                },
                                "description": "List of resources to revoke access from."
                            }
                        },
                        "required": [
                            "grant",
                            "revoke"
                        ],
                        "description": "Specify the access changes to apply, including resources to grant or revoke."
                    }
                },
                "required": [
                    "username",
                    "access_changes"
                ]
            }
        },
