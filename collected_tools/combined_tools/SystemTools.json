                    "method": {
                        "type": "string",
                        "enum": [
                            "GET",
                            "POST",
                            "PUT",
                            "DELETE",
                            "HEAD",
                            "OPTIONS"
                        ],
                        "description": "Select the HTTP method to use.",
                        "default": "GET"
                    },
                    "headers": {
                        "type": "object",
                        "description": "Provide HTTP headers to include in the request."
                    },
                    "data": {
                        "type": [
                            "string",
                            "object"
                        ],
                        "description": "Include data to send in the request body."
                    },
                    "timeout": {
                        "type": "integer",
                        "description": "Set the request timeout in seconds.",
                        "default": 30
                    },
                    "follow_redirects": {
                        "type": "boolean",
                        "description": "Indicate whether to follow HTTP redirects.",
                        "default": true
                    },
                    "verify_ssl": {
                        "type": "boolean",
                        "description": "Indicate whether to verify SSL certificates.",
                        "default": true
                    }
                },
                "required": [
                    "url"
                ]
            }
        },
        "category": "SystemTools",
        "tool_type": "Sensitive",
        "source": "AgentAlign"
    },
