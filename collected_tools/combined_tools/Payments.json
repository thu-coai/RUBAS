                                "quantity",
                                "unit_amount"
                            ]
                        }
                    }
                },
                "required": [
                    "amount",
                    "description",
                    "payer_email",
                    "return_url",
                    "cancel_url",
                    "items"
                ]
            }
        },
        "category": "Payments",
        "tool_type": "Sensitive",
        "source": "AgentAlign"
