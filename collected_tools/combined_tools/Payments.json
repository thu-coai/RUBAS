    {
        "type": "function",
        "function": {
            "name": "stripe_create_payment",
            "description": "Create a Stripe payment session with payment links and QR code for various payment methods.",
            "parameters": {
                "type": "object",
                "properties": {
                    "amount": {
                        "type": "number",
                        "description": "Specify the amount in the smallest currency unit (e.g., cents for USD). For example, $10.00 should be passed as 1000."
                    },
                    "currency": {
                        "type": "string",
                        "description": "Provide a three-letter ISO currency code (e.g., USD, EUR, GBP).",
                        "pattern": "^[A-Z]{3}$"
                    },
                    "payment_method_types": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": [
                                "card",
                                "alipay",
                                "wechat_pay",
                                "klarna",
                                "afterpay_clearpay",
                                "ideal"
                            ]
                        },
                        "description": "List the payment methods to accept."
                    },
                    "success_url": {
                        "type": "string",
                        "description": "Provide the URL to redirect after successful payment."
                    },
                    "cancel_url": {
                        "type": "string",
                        "description": "Provide the URL to redirect after cancelled payment."
                    },
                    "customer_email": {
                        "type": "string",
                        "description": "Specify the customer's email address."
                    },
                    "description": {
                        "type": "string",
                        "description": "Add an optional description for the payment."
                    },
                    "metadata": {
                        "type": "object",
                        "description": "Include optional key-value pairs for additional payment information."
                    }
                },
                "required": [
                    "amount",
                    "currency",
                    "payment_method_types",
                    "success_url",
                    "cancel_url",
                    "customer_email"
                ]
            }
        },
        "category": "Payments",
        "tool_type": "Sensitive",
        "source": "AgentAlign"
    }
