                            "CAPTURE",
                            "AUTHORIZE"
                        ],
                        "default": "CAPTURE"
                    },
                    "payer_email": {
                        "type": "string",
                        "description": "Enter the email address of the payer."
                    },
                    "return_url": {
                        "type": "string",
                        "description": "Specify the URL to redirect to after successful payment."
                    },
                    "cancel_url": {
                        "type": "string",
                        "description": "Specify the URL to redirect to if payment is cancelled."
                    },
                    "items": {
                        "type": "array",
                        "description": "List the items being purchased.",
                        "items": {
                            "type": "object",
