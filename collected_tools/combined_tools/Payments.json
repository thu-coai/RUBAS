    {
        "type": "function",
        "function": {
            "name": "create_paypal_payment",
            "description": "Create a new payment request using PayPal.",
            "parameters": {
                "type": "object",
                "properties": {
                    "amount": {
                        "type": "number",
                        "description": "Specify the payment amount (up to 2 decimal places)."
                    },
                    "currency": {
                        "type": "string",
                        "description": "Specify the payment currency code.",
                        "enum": [
                            "USD",
                            "EUR",
                            "GBP",
                            "CAD",
                            "AUD"
                        ],
                        "default": "USD"
                    },
                    "description": {
                        "type": "string",
