[
    {
        "type": "function",
        "function": {
            "name": "create_alipay_payment",
            "description": "Create a new payment request using Alipay.",
            "parameters": {
                "type": "object",
                "properties": {
                    "amount": {
                        "type": "number",
                        "description": "Payment amount (up to 2 decimal places)."
                    },
                    "currency": {
                        "type": "string",
                        "description": "Payment currency code.",
                        "enum": [
                            "CNY",
                            "USD",
                            "JPY",
                            "EUR",
                            "GBP",
                            "HKD",
                            "CAD",
                            "AUD"
                        ],
                        "default": "CNY"
                    },
                    "subject": {
                        "type": "string",
                        "description": "Payment subject or description."
                    },
                    "buyer_id": {
                        "type": "string",
                        "description": "Alipay user ID of the buyer."
                    },
                    "payment_method": {
                        "type": "string",
                        "description": "Payment method to use.",
                        "enum": [
                            "BALANCE",
                            "BANK_CARD",
                            "CREDIT_PAY"
                        ],
                        "default": "BALANCE"
                    },
                    "notify_url": {
                        "type": "string",
                        "description": "URL for receiving payment notifications."
                    }
                },
                "required": [
                    "amount",
                    "subject",
                    "buyer_id",
                    "notify_url"
                ]
            }
        },
        "category": "Payments",
        "tool_type": "Sensitive",
        "source": "AgentAlign"
    },
